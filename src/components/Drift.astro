---
// a thin strip where stray data wanders across the page between sections
interface Props { items?: string[] }
const { items = ['events_0842.json', 'bronze → silver → gold', '{ "status": "migrating" }'] } = Astro.props;
---

<div class="drift" aria-hidden="true">
  {items.map((t, i) => (
    <span class="mono" style={`--i:${i}; --y:${16 + i * 27}%`}>{t}</span>
  ))}
</div>

<style>
  .drift {
    position: relative; height: 48px; overflow: hidden;
    max-width: var(--width-page); margin: 0 auto;
  }
  .drift span {
    position: absolute; top: var(--y); left: -20%;
    font-size: 10px; letter-spacing: 0.14em; color: var(--muted);
    white-space: nowrap; opacity: 0;
    animation: driftby 26s linear infinite;
    animation-delay: calc(var(--i) * 9s - 18s);
  }
  @keyframes driftby {
    0% { left: -20%; opacity: 0; }
    8% { opacity: 0.5; }
    60% { opacity: 0.5; }
    94% { opacity: 0; }
    100% { left: 103%; opacity: 0; }
  }
  :global(html[data-mode='night']) .drift span:nth-child(2) { color: var(--neon-cyan); }
  :global(html[data-mode='night']) .drift span:nth-child(3) { color: var(--neon-pink); }
  @media (prefers-reduced-motion: reduce) { .drift { display: none; } }
</style>
