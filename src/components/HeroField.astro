---
// the landing: raw data drifts as entropy, then gets extracted into the name.
// on scroll the name dissolves upward into the navbar, bit by bit.
// night mode: a pixelated kaju patrols the bottom of the field.
---

<div class="fieldwrap" aria-hidden="true">
  <canvas id="field"></canvas>
</div>

<script>
  const canvas = document.getElementById('field') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const CHARS = '{}[]<>/;:#%&01,.'.split('');
  const TOKENS = ['csv', 'json', 'null', 'NaN', 'log', 'api', 'avro',
    '2026-07-04T09:12:33Z', '1719946337', '63.4', '0.9997', '3.14159',
    '404', '1e-9', '07:07', 'UTC+2', '0xFF'];
  const NAME = 'OJASWI';
  const FREE = 26; // permanent wanderers that never join the name

  let W = 0, H = 0, dpr = 1;
  let colors = { accent: '#1D4ED8', muted: '#777', ink: '#111', mode: 'day' };
  let palette: string[] = [];

  function refreshColors() {
    const cs = getComputedStyle(document.documentElement);
    colors = {
      accent: cs.getPropertyValue('--accent').trim(),
      muted: cs.getPropertyValue('--muted').trim(),
      ink: cs.getPropertyValue('--ink').trim(),
      mode: document.documentElement.dataset.mode || 'day',
    };
    palette = colors.mode === 'night'
      ? [colors.accent,
         cs.getPropertyValue('--neon-cyan').trim(),
         cs.getPropertyValue('--neon-pink').trim(),
         cs.getPropertyValue('--neon-amber').trim()]
      : [colors.accent];
  }

  type P = {
    x: number; y: number; vx: number; vy: number;
    tx: number; ty: number; sx: number; sy: number;
    g: string; fb: number; seed: number; ci: number; keep: boolean;
    state: 'chaos' | 'pull' | 'set' | 'stray' | 'return' | 'free';
    t0: number;
  };
  let ps: P[] = [];
  const start = performance.now();
  const CHAOS_END = 1500;
  const PULL_DUR = 900;
  let stagger = 2; // ms per particle, set after sampling
  const FONTS = ['10px', '11.5px', '13px'].map((s) => `${s} ui-monospace, Menlo, monospace`);

  function newP(free: boolean): P {
    const g = Math.random() < 0.16
      ? TOKENS[Math.floor(Math.random() * TOKENS.length)]
      : CHARS[Math.floor(Math.random() * CHARS.length)];
    return {
      x: Math.random() * W, y: Math.random() * H,
      vx: (Math.random() - 0.5) * 0.5, vy: (Math.random() - 0.5) * 0.5,
      tx: 0, ty: 0, sx: 0, sy: 0,
      g,
      fb: Math.floor(Math.random() * 3),
      seed: Math.random() * 7,
      ci: Math.floor(Math.random() * 4), keep: Math.random() < 0.2,
      state: free ? 'free' : 'chaos', t0: 0,
    };
  }

  // sample the name into target points, anchored to the (sr-only) name slot
  function sampleName(): { x: number; y: number }[] {
    const slot = document.getElementById('heroName');
    const host = canvas.parentElement!.getBoundingClientRect();
    if (!slot) return [];
    const r = slot.getBoundingClientRect();
    const ox = r.left - host.left, oy = r.top - host.top;
    const off = document.createElement('canvas');
    off.width = Math.max(2, Math.round(r.width));
    off.height = Math.max(2, Math.round(r.height));
    const oc = off.getContext('2d')!;
    oc.font = '900 100px system-ui, -apple-system, sans-serif';
    const w100 = oc.measureText(NAME).width;
    const fs = Math.min(r.height / 0.78, (100 * r.width) / w100);
    oc.font = `900 ${fs}px system-ui, -apple-system, sans-serif`;
    oc.textBaseline = 'alphabetic';
    oc.fillStyle = '#fff';
    oc.fillText(NAME, 0, fs * 0.78);
    const step = Math.max(3, Math.round(fs / 30));
    const img = oc.getImageData(0, 0, off.width, off.height).data;
    const pts: { x: number; y: number }[] = [];
    for (let y = 0; y < off.height; y += step)
      for (let x = 0; x < off.width; x += step)
        if (img[(y * off.width + x) * 4 + 3] > 128) pts.push({ x: ox + x, y: oy + y });
    while (pts.length > 1400) pts.splice(Math.floor(Math.random() * pts.length), 1);
    return pts;
  }

  function rebuild(snap: boolean) {
    const pts = sampleName();
    const total = pts.length + FREE;
    while (ps.length < total) ps.push(newP(ps.length >= pts.length));
    ps.length = total;
    ps.forEach((p, i) => {
      if (i >= pts.length) { p.state = 'free'; return; }
      p.tx = pts[i].x; p.ty = pts[i].y;
      if (snap) { p.state = 'set'; p.x = p.tx; p.y = p.ty; }
    });
    stagger = Math.min(1100 / Math.max(pts.length, 1), 3);
  }

  function size() {
    const r = canvas.parentElement!.getBoundingClientRect();
    W = r.width; H = r.height;
    dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = W * dpr; canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  size();
  refreshColors();
  rebuild(false);
  addEventListener('resize', () => {
    size();
    rebuild(performance.now() - start > CHAOS_END + 1100 + PULL_DUR);
    if (reduced) staticDraw();
  });
  new MutationObserver(() => { refreshColors(); if (reduced) staticDraw(); })
    .observe(document.documentElement, { attributes: true, attributeFilter: ['data-mode'] });

  const ease = (t: number) => t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

  // ---- pixel kaju (night only) ----
  const KA = [
    '..............BB..',
    '.............BBDB.',
    '.............DBBBD',
    '..............BBB.',
    'TT.BBBBBBBBBBBBB..',
    '.TBBBBBBBBBBBBB...',
    '..BBBBBBBBBBBB....',
    '..BBB......BBB....',
    '..BB........BB....',
    '..BB........BB....',
    '..DD........DD....',
  ];
  const KB = [
    '..............BB..',
    '.............BBDB.',
    '.............DBBBD',
    '..............BBB.',
    '.T.BBBBBBBBBBBBB..',
    'TTBBBBBBBBBBBBB...',
    '..BBBBBBBBBBBB....',
    '.BBB........BBB...',
    '.BB..........BB...',
    'BB............BB..',
    'DD............DD..',
  ];
  const KPX = 3, KW = 18 * KPX, KH = 11 * KPX;
  const kaju = { x: -KW - 20, walking: false, next: start + 5200 };

  function drawSprite(map: string[], x: number, y: number) {
    for (let r = 0; r < map.length; r++)
      for (let c = 0; c < map[r].length; c++) {
        const ch = map[r][c];
        if (ch === '.') continue;
        ctx.fillStyle = ch === 'D' ? '#6B4E2A' : '#E8C27C';
        ctx.fillRect(x + c * KPX, y + r * KPX, KPX, KPX);
      }
  }

  function drawKaju(now: number) {
    if (colors.mode !== 'night') return;
    if (!kaju.walking && now >= kaju.next) { kaju.walking = true; kaju.x = -KW - 20; }
    if (!kaju.walking) return;
    kaju.x += 1.1;
    if (kaju.x > W + 30) { kaju.walking = false; kaju.next = now + 21000; return; }
    drawSprite(Math.floor(now / 150) % 2 ? KA : KB, kaju.x, H - KH - 6);
    ctx.fillStyle = palette[2] || colors.accent;
    ctx.font = '11px ui-monospace, Menlo, monospace';
    ctx.fillText('{}', kaju.x + KW + 16, H - 14 + Math.sin(now / 160) * 4);
  }

  // ---- main loop ----
  let nextStray = start + CHAOS_END + 1100 + PULL_DUR + 2600;
  const buckets: P[][] = [[], [], []];

  function frame(now: number) {
    ctx.clearRect(0, 0, W, H);
    const el = now - start;

    // scroll dissolve: the name flies up-left into the navbar as you scroll
    const pr = Math.min(Math.max(scrollY / (H * 0.55), 0), 1);
    const g = pr * pr;
    const bx = 90, by = -30; // roughly where the brand lives, above the canvas

    if (now >= nextStray) {
      const cand = ps.filter((p) => p.state === 'set');
      if (cand.length) {
        const p = cand[Math.floor(Math.random() * cand.length)];
        p.state = 'stray'; p.t0 = now;
        p.vx = (Math.random() - 0.5) * 1.4; p.vy = -0.4 - Math.random() * 0.8;
      }
      nextStray = now + 2600 + Math.random() * 2200;
    }

    buckets.forEach((b) => (b.length = 0));
    const night = palette.length > 1;

    ps.forEach((p, i) => {
      let alpha = 0.5, asDot = false, col = night ? palette[p.ci] : colors.muted;

      if (p.state === 'free') {
        p.x += p.vx * 0.6 + Math.sin(el / 900 + p.seed) * 0.15;
        p.y += p.vy * 0.6 + Math.cos(el / 800 + p.seed) * 0.15;
        if (p.x < -20) p.x = W + 20; if (p.x > W + 20) p.x = -20;
        if (p.y < -20) p.y = H + 20; if (p.y > H + 20) p.y = -20;
        alpha = 0.16 + 0.1 * Math.sin(el / 600 + p.seed * 3);
      }
      if (p.state === 'chaos') {
        const pullStart = CHAOS_END + i * stagger;
        if (el >= pullStart) { p.state = 'pull'; p.sx = p.x; p.sy = p.y; p.t0 = now; }
        else {
          p.x += p.vx + Math.sin(el / 400 + p.seed) * 0.3;
          p.y += p.vy + Math.cos(el / 350 + p.seed) * 0.3;
          if (p.x < 0 || p.x > W) p.vx *= -1;
          if (p.y < 0 || p.y > H) p.vy *= -1;
          alpha = 0.35 + 0.25 * Math.sin(el / 300 + p.seed * 3);
        }
      }
      if (p.state === 'pull') {
        const t = Math.min((now - p.t0) / PULL_DUR, 1);
        const e = ease(t);
        p.x = p.sx + (p.tx - p.sx) * e;
        p.y = p.sy + (p.ty - p.sy) * e;
        col = t > 0.6 ? (night ? colors.accent : colors.ink) : col;
        alpha = 0.55;
        if (t === 1) p.state = 'set';
      }
      if (p.state === 'set') {
        p.x = p.tx; p.y = p.ty;
        asDot = true;
        // day: near-solid ink dots (Swiss type, readable); night: phosphor shimmer
        if (night) {
          alpha = 0.62 + 0.25 * Math.sin(now / 1500 + i * 0.6);
          col = p.keep ? palette[p.ci] : colors.accent;
        } else {
          alpha = 0.82 + 0.13 * Math.sin(now / 1800 + i * 0.6);
          col = p.keep ? colors.accent : colors.ink;
        }
      }
      if (p.state === 'stray') {
        p.x += p.vx; p.y += p.vy;
        alpha = 0.7;
        if (now - p.t0 > 2000) { p.state = 'return'; p.sx = p.x; p.sy = p.y; p.t0 = now; }
      }
      if (p.state === 'return') {
        const t = Math.min((now - p.t0) / 700, 1);
        const e = ease(t);
        p.x = p.sx + (p.tx - p.sx) * e;
        p.y = p.sy + (p.ty - p.sy) * e;
        col = colors.accent; alpha = 0.7;
        if (t === 1) p.state = 'set';
      }

      // apply the scroll dissolve (free wanderers just fade)
      let dx = p.x, dy = p.y, da = alpha;
      if (p.state === 'free') da = alpha * (1 - pr);
      else { dx = p.x + (bx - p.x) * g; dy = p.y + (by - p.y) * g; da = alpha * Math.max(1 - pr * 1.15, 0); }
      if (da <= 0.02) return;

      if (asDot) {
        ctx.globalAlpha = da;
        ctx.fillStyle = col;
        ctx.fillRect(dx, dy, 3, 3);
      } else {
        // glyphs are batched by font bucket below (scratch fields, not sx/sy)
        const q = p as any;
        q._x = dx; q._y = dy; q._a = da; q._c = col;
        buckets[p.fb].push(p);
      }
    });

    buckets.forEach((b, bi) => {
      if (!b.length) return;
      ctx.font = FONTS[bi];
      b.forEach((p: any) => {
        ctx.globalAlpha = p._a;
        ctx.fillStyle = p._c;
        ctx.fillText(p.g, p._x, p._y);
      });
    });
    ctx.globalAlpha = 1;

    if (pr < 0.98) drawKaju(now);
    requestAnimationFrame(frame);
  }

  function staticDraw() {
    ctx.clearRect(0, 0, W, H);
    ctx.globalAlpha = 0.85;
    ctx.fillStyle = colors.mode === 'night' ? colors.accent : colors.ink;
    ps.forEach((p) => { if (p.state !== 'free') ctx.fillRect(p.tx, p.ty, 3, 3); });
    ctx.globalAlpha = 1;
    if (colors.mode === 'night') drawSprite(KA, 24, H - KH - 6);
  }

  if (reduced) {
    rebuild(true);
    staticDraw();
  } else {
    requestAnimationFrame(frame);
  }
</script>

<style>
  .fieldwrap {
    position: absolute; inset: 0;
    pointer-events: none; overflow: hidden;
  }
  canvas { width: 100%; height: 100%; display: block; opacity: 0.9; }
  :global(html[data-mode='night']) canvas { opacity: 0.95; }
</style>
