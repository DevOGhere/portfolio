---
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = 'Ojaswi Sharma · Data Solutions Engineer',
  description = 'Data solutions engineer in Göttingen. Production Databricks pipelines, a Kafka pipeline with a measured P99, and a village of 100 AI agents. Receipts included.',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://ojaswishere.in').href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ojaswi Sharma',
  url: 'https://ojaswishere.in',
  jobTitle: 'Data Solutions Engineer',
  description: 'Data engineer turned MSc student in Göttingen. Built production Databricks and Delta Lake pipelines for healthcare clients, a live Kafka market-data pipeline, and a deterministic multi-agent simulation.',
  homeLocation: { '@type': 'Place', name: 'Göttingen, Germany' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Georg-August-Universität Göttingen' },
    { '@type': 'CollegeOrUniversity', name: 'Guru Gobind Singh Indraprastha University' },
  ],
  knowsAbout: ['Data engineering', 'Data modeling', 'Databricks', 'Delta Lake', 'Apache Kafka', 'SQL', 'Python', 'Data quality', 'Business intelligence'],
  sameAs: ['https://github.com/DevOGhere', 'https://linkedin.com/in/ojaswishere'],
};
import '../styles/global.css';
---

<!doctype html>
<html lang="en" data-mode="day">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <meta property="og:image" content="https://ojaswishere.in/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <script is:inline>
      // apply saved mode before first paint to avoid flash
      const saved = localStorage.getItem('mode');
      if (saved === 'night' || saved === 'day') {
        document.documentElement.setAttribute('data-mode', saved);
      }
    </script>
  </head>
  <body>
    <header class="topbar">
      <nav class="wrap">
        <span class="brand mono">OJASWI SHARMA</span>
        <div class="right">
          <a class="cv mono" href="/cv.pdf" target="_blank" rel="noopener" aria-label="Open my CV (PDF, opens in a new tab)">
            CV
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M14.5 1.5 1.5 7l4.6 2 2 4.6zM6.1 9l8.4-7.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" stroke-linecap="round"/></svg>
          </a>
          <button id="mode-toggle" aria-label="Switch between day and night mode">
            <span class="t-day">DAY</span><span class="t-night">NIGHT</span>
          </button>
        </div>
      </nav>
    </header>

    <nav class="dotnav" aria-label="Section navigation">
      <a href="#top" aria-label="Top"></a>
      <a href="#experience" aria-label="Experience"></a>
      <a href="#work" aria-label="Selected work"></a>
      <a href="#education" aria-label="Education"></a>
      <a href="#competencies" aria-label="Competencies"></a>
      <a href="#shelf" aria-label="The shelf" class="only-night"></a>
      <a href="#research" aria-label="Research"></a>
    </nav>

    <slot />

    <script>
      const html = document.documentElement;
      const btn = document.getElementById('mode-toggle')!;
      btn.setAttribute('aria-pressed', String(html.getAttribute('data-mode') === 'night'));
      btn.addEventListener('click', () => {
        const night = html.getAttribute('data-mode') === 'night';
        const next = night ? 'day' : 'night';
        html.setAttribute('data-mode', next);
        localStorage.setItem('mode', next);
        btn.setAttribute('aria-pressed', String(!night));
      });

      // scroll reveals
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.rv').forEach((el) => io.observe(el));

      // brand slides into the navbar once the hero name scrolls away
      const brand = document.querySelector('.brand')!;
      const heroName = document.getElementById('heroName');
      if (heroName) {
        new IntersectionObserver(([e]) => {
          brand.classList.toggle('show', !e.isIntersecting);
        }).observe(heroName);
      } else {
        brand.classList.add('show');
      }

      // dot rail scrollspy
      const dots = [...document.querySelectorAll<HTMLAnchorElement>('.dotnav a')];
      const spy = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const id = '#' + e.target.id;
            dots.forEach((d) => d.classList.toggle('on', d.getAttribute('href') === id));
          });
        },
        { rootMargin: '-42% 0px -52%' }
      );
      dots.forEach((d) => {
        const t = document.querySelector(d.getAttribute('href')!);
        if (t) spy.observe(t);
        else d.style.display = 'none'; // rail only shows sections that exist on this page
        // arriving at education via the rail: open both course skies,
        // fold back on the next user scroll (hover keeps working as usual)
        if (d.getAttribute('href') === '#education') {
          d.addEventListener('click', () => {
            const cards = document.querySelectorAll('.edu');
            cards.forEach((c) => c.classList.add('open'));
            const close = () => cards.forEach((c) => c.classList.remove('open'));
            setTimeout(() => {
              addEventListener('wheel', close, { once: true, passive: true });
              addEventListener('touchstart', close, { once: true, passive: true });
            }, 1200);
          });
        }
      });

      // easter egg: press K at night. the dog inspects your screen.
      const EKA = [
        '..............BB..',
        '.............BBDB.',
        '.............DBBBD',
        '..............BBB.',
        'TT.BBBBBBBBBBBBB..',
        '.TBBBBBBBBBBBBB...',
        '..BBBBBBBBBBBB....',
        '..BBB......BBB....',
        '..BB........BB....',
        '..BB........BB....',
        '..DD........DD....',
      ];
      const EKB = [
        '..............BB..',
        '.............BBDB.',
        '.............DBBBD',
        '..............BBB.',
        '.T.BBBBBBBBBBBBB..',
        'TTBBBBBBBBBBBBB...',
        '..BBBBBBBBBBBB....',
        '.BBB........BBB...',
        '.BB..........BB...',
        'BB............BB..',
        'DD............DD..',
      ];
      // same dog, tail up: the wag is these two swapping
      const EKW = EKA.map((r, i) => i === 3 ? 'T.............BBB.' : i === 4 ? '.T.BBBBBBBBBBBBB..' : i === 5 ? '.BBBBBBBBBBBBBB...' : r);
      let egging = false;
      addEventListener('keydown', (e) => {
        if (egging || e.key.toLowerCase() !== 'k' || e.metaKey || e.ctrlKey || e.altKey) return;
        const tg = e.target as HTMLElement;
        if (tg && /input|textarea|select/i.test(tg.tagName)) return;
        if (html.getAttribute('data-mode') !== 'night') return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        egging = true;
        const dpr = Math.min(devicePixelRatio || 1, 2);
        const cv = document.createElement('canvas');
        const W = innerWidth, H = innerHeight;
        cv.width = W * dpr; cv.height = H * dpr;
        cv.style.cssText = 'position:fixed;inset:0;width:100%;height:100%;z-index:980;pointer-events:none';
        document.body.appendChild(cv);
        const ctx = cv.getContext('2d')!;
        ctx.scale(dpr, dpr);
        const P = 12, KW = 18 * P, KH = 11 * P;
        const mid = (W - KW) / 2;
        const mouthX = mid + 16 * P, mouthY0 = H - KH - 10 + 3 * P;
        // walk in, sniff, three licks, proud wag, walk out
        const WALK = 2200, SNIFF = 900, PASS = 900, PASSES = 3, PROUD = 1300;
        const A = WALK, B = A + SNIFF, C = B + PASS * PASSES, D = C + PROUD, TOTAL = D + WALK;
        const t0 = performance.now();
        const paint = (map: string[], x: number, y: number) => {
          for (let r = 0; r < map.length; r++)
            for (let c = 0; c < map[r].length; c++) {
              const ch = map[r][c];
              if (ch === '.') continue;
              ctx.fillStyle = ch === 'B' ? '#E8C27C' : '#6B4E2A';
              ctx.fillRect(x + c * P, y + r * P, P, P);
            }
        };
        const mono = '600 13px ui-monospace, SFMono-Regular, monospace';
        const say = (txt: string, x: number, y: number, a: number) => {
          if (a <= 0) return;
          ctx.font = mono; ctx.textAlign = 'center';
          ctx.fillStyle = `rgba(255,122,217,${Math.min(a, 0.9).toFixed(2)})`;
          ctx.fillText(txt, x, y);
        };
        // each lick is a wet swipe from the mouth up the glass: it stays wet for a moment, drips, then dries
        const swipes: { pts: { x: number; y: number }[]; fin: number }[] = [];
        const drips: { x: number; y: number; len: number; a: number }[] = [];
        const wet = (s: { pts: { x: number; y: number }[]; fin: number }, now: number) =>
          s.fin < 0 ? 1 : Math.max(0, 1 - (now - s.fin - 700) / 2600);
        let lastK = -1, cur: { pts: { x: number; y: number }[]; fin: number } | null = null;
        const stroke = (pts: { x: number; y: number }[], w: number, style: string) => {
          if (pts.length < 2) return;
          ctx.lineWidth = w; ctx.strokeStyle = style;
          ctx.beginPath(); ctx.moveTo(pts[0].x, pts[0].y);
          for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i].x, pts[i].y);
          ctx.stroke();
        };
        const step = (now: number) => {
          const t = now - t0;
          ctx.clearRect(0, 0, W, H);
          ctx.lineCap = 'round'; ctx.lineJoin = 'round';
          let x = mid, walking = false;
          if (t < A) { const u = t / A; x = -KW + (mid + KW) * (1 - (1 - u) ** 2); walking = u < 0.97; }   // slows as it arrives
          else if (t >= D) { const u = Math.min((t - D) / WALK, 1); x = mid + (W + KW - mid) * u * u; walking = true; }   // trots off, speeding up
          const sniffing = t >= A && t < B, licking = t >= B && t < C, proud = t >= C && t < D;

          // the wet glass, drawn behind the dog
          for (let i = swipes.length - 1; i >= 0; i--) if (wet(swipes[i], now) <= 0) swipes.splice(i, 1);
          for (const s of swipes) {
            const a = wet(s, now);
            stroke(s.pts, 120, `rgba(255,122,217,${(0.07 * a).toFixed(3)})`);
            stroke(s.pts, 64, `rgba(255,122,217,${(0.12 * a).toFixed(3)})`);
            stroke(s.pts, 18, `rgba(255,214,242,${(0.16 * a).toFixed(3)})`);   // the shine on the wet middle
          }
          for (let i = drips.length - 1; i >= 0; i--) {
            const d = drips[i];
            d.y += 0.45; d.len += 0.12; d.a *= 0.992;
            if (d.a < 0.02) { drips.splice(i, 1); continue; }
            ctx.strokeStyle = `rgba(255,170,230,${d.a.toFixed(3)})`; ctx.lineWidth = 3;
            ctx.beginPath(); ctx.moveTo(d.x, d.y - d.len); ctx.lineTo(d.x, d.y); ctx.stroke();
          }

          let hop = 0, flick = 0;
          if (sniffing) hop = Math.round(Math.sin(t / 70) * 2);     // nose twitch
          if (licking) {
            const k = Math.floor((t - B) / PASS), lt = ((t - B) % PASS) / PASS;
            const e = 1 - (1 - lt) ** 2;                              // leaves fast, trails off slow
            const dir = k % 2 ? -1 : 1;
            if (k !== lastK) { lastK = k; cur = { pts: [], fin: -1 }; swipes.push(cur); }
            const s = cur!;
            if (s.fin < 0) {
              const tx = mouthX + dir * Math.sin(e * Math.PI) * W * 0.16 + Math.sin(e * 9) * 10;
              const ty = mouthY0 - e * H * 0.9;
              s.pts.push({ x: tx, y: ty });
              if (e > 0.3 && Math.random() < 0.12) drips.push({ x: tx + (Math.random() - 0.5) * 40, y: ty, len: 6, a: 0.55 });
              if (lt > 0.96) s.fin = now;
            }
            hop = -Math.round(Math.abs(Math.sin(lt * Math.PI)) * 8);   // a little hop into each lick
            flick = Math.floor(now / 90) % 2;
          } else if (cur && cur.fin < 0) cur.fin = now;

          const dy = H - KH - 10 + hop;
          const sprite = walking ? (Math.floor(now / 140) % 2 ? EKB : EKA)
            : proud ? (Math.floor(now / 80) % 2 ? EKW : EKA)          // tail going
            : licking ? (Math.floor(now / 160) % 2 ? EKW : EKA) : EKA;
          paint(sprite, x, dy);
          if (licking) {
            ctx.fillStyle = '#FF7AD9'; ctx.fillRect(mouthX, dy + 3 * P, P * 2, P * (2 + flick));
            ctx.fillStyle = '#FF4FC4'; ctx.fillRect(mouthX, dy + 3 * P + P * (1 + flick), P * 2, P);
          }
          if (sniffing) say('sniff... sniff...', mid + KW / 2, dy - 20, Math.min((t - A) / 250, 1));
          if (t >= C && t < D + 450) say('* lick *  screen cleaned. no crumbs found.', W / 2, H - KH - 52, Math.min((t - C) / 400, 1) * (t > D ? 1 - (t - D) / 450 : 1));

          if (t < TOTAL || swipes.length || drips.length) requestAnimationFrame(step);
          else { cv.remove(); egging = false; }
        };
        requestAnimationFrame(step);
      });
    </script>

    <style>
      .topbar {
        position: sticky; top: 0; z-index: 60;
        background: color-mix(in srgb, var(--ground) 86%, transparent);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border-bottom: var(--rule-w) solid var(--rule);
        transition: border-color 0.5s, background 0.5s;
      }
      .topbar nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 14px;
        padding-bottom: 14px;
      }
      .right { display: flex; align-items: center; gap: 14px; }
      .cv {
        display: inline-flex; align-items: center; gap: 6px;
        font-size: 11px; letter-spacing: 0.14em; font-weight: 700;
        color: var(--ink); text-decoration: none;
        border-bottom: 2px solid var(--accent); padding: 4px 0 2px;
      }
      .cv svg { transition: transform 0.25s ease; }
      .cv:hover svg, .cv:focus-visible svg { transform: translate(2px, -2px); }
      .cv:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
      @media (prefers-reduced-motion: reduce) { .cv svg { transition: none; } }
      .brand {
        font-weight: 800; letter-spacing: 0.02em; font-size: 14px;
        opacity: 0; transform: translateY(9px);
        transition: opacity 0.45s ease, transform 0.45s ease;
      }
      .brand.show { opacity: 1; transform: none; }

      .dotnav {
        position: fixed; right: 18px; top: 50%;
        transform: translateY(-50%);
        display: flex; flex-direction: column; gap: 14px;
        z-index: 55;
      }
      .dotnav a {
        width: 8px; height: 8px; border-radius: 50%;
        border: 1.5px solid var(--muted); opacity: 0.5;
        transition: opacity 0.3s, transform 0.3s, background 0.3s, border-color 0.3s, box-shadow 0.3s;
      }
      .dotnav a:hover { opacity: 0.9; }
      .dotnav a.on {
        background: var(--accent); border-color: var(--accent);
        opacity: 1; transform: scale(1.3);
      }
      :global(html[data-mode='night']) .dotnav a.on {
        box-shadow: 0 0 10px color-mix(in srgb, var(--accent) 65%, transparent);
      }
      .dotnav a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
      @media (max-width: 900px) { .dotnav { display: none; } }
      @media (prefers-reduced-motion: reduce) { .brand { transition: none; } }
      #mode-toggle {
        border: 1px solid var(--border);
        background: var(--card);
        border-radius: 999px;
        cursor: pointer;
        font: inherit;
        display: flex;
        padding: 3px;
      }
      #mode-toggle span {
        font-family: var(--font-mono);
        font-size: 10.5px;
        letter-spacing: 0.14em;
        padding: 5px 13px;
        border-radius: 999px;
        color: var(--muted);
        transition: background 0.3s, color 0.3s;
      }
      :global(html[data-mode='day']) #mode-toggle .t-day,
      :global(html[data-mode='night']) #mode-toggle .t-night {
        background: var(--ink);
        color: var(--ground);
      }
      #mode-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    </style>
  </body>
</html>
